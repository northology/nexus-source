{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/bin/nexus.mjs\" hook",
            "commandWindows": "node \"${PLUGIN_ROOT}/bin/nexus.mjs\" hook",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|Bash|shell|exec_command|local_shell|container\\.exec|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/bin/guard.mjs\"",
            "commandWindows": "node \"${PLUGIN_ROOT}/bin/guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/bin/docs-check.mjs\" --hook",
            "commandWindows": "node \"${PLUGIN_ROOT}/bin/docs-check.mjs\" --hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
