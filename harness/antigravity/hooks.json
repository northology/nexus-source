{
  "nexus": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./bin/nexus.mjs hook",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./bin/guard.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
